{
  "name": "kulturni-azyl-payload-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "npm run payload -- generate:types",
    "generate:importmap": "npm run payload -- generate:importmap",
    "seed": "tsx scripts/seed.ts",
    "ci": "cross-env PAYLOAD_MIGRATING=true payload migrate && next build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/storage-vercel-blob": "3.86.0",
    "dotenv": "latest",
    "graphql": "latest",
    "next": "15.4.11",
    "payload": "3.86.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "cross-env": "latest",
    "eslint": "latest",
    "eslint-config-next": "15.4.11",
    "tsx": "latest",
    "typescript": "5.8.3"
  }
}
