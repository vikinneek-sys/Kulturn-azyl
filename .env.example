PAYLOAD_SECRET=vygeneruj-dlouhy-nahodny-tajny-retezec
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Persistentní úložiště médií (S3/AWS nebo S3-compatible provider).
# Bez těchto hodnot se použije lokální složka media/ pouze pro vývoj.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# AdSense: doplň až po schválení webu Googlem.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_HOME=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=0987654321
